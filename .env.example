# SMTP is required for real email OTP delivery. Never commit .env.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-app-password
SMTP_FROM=Chettik <mailer@example.com>
# Optional local/CI-only override. When set, no email is sent.
# OTP_DEV_CODE=123456
MEDIA_STORAGE=local
MEDIA_ROOT=backend/media
MEDIA_MAX_BYTES=26214400
MEDIA_RETENTION_DAYS=30
MESSAGE_PAGE_SIZE=50
# Local in-process limits per rolling window. For a public deployment use a shared limiter.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_OTP_REQUEST=20
RATE_LIMIT_OTP_VERIFY=30
RATE_LIMIT_MESSAGE_SEND=40
RATE_LIMIT_MEDIA_UPLOAD=10
RATE_LIMIT_INVITE=10
RATE_LIMIT_REPORT=10
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8787
API_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_URL=http://127.0.0.1:8787/api
PYTHON_API_MODULE=backend.main:app
